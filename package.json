{
  "name": "starlight-themes",
  "version": "0.0.1",
  "license": "MIT",
  "description": "The one place to preview all Starlight themes.",
  "author": "HiDeoo <github@hideoo.dev> (https://hideoo.dev)",
  "type": "module",
  "scripts": {
    "dev": "vite-node src/dev.ts",
    "build": "NODE_ENV=production vite-node src/build.ts",
    "preview": "astro preview",
    "updates": "vite-node src/updates.ts",
    "lint": "eslint . --cache --max-warnings=0",
    "format": "prettier -w --cache --ignore-unknown ."
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.4",
    "@catppuccin/starlight": "^2.1.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@pelagornis/page": "^1.0.7",
    "@six-tech/starlight-theme-six": "^1.0.16",
    "astro": "^7.1.3",
    "lucode-starlight": "^0.1.6",
    "sharp": "^0.34.4",
    "starlight-ion-theme": "^2.4.0",
    "starlight-theme-black": "^0.7.1",
    "starlight-theme-celestia": "^0.2.4",
    "starlight-theme-dracula": "^0.1.1",
    "starlight-theme-exquisitus": "^1.2.0",
    "starlight-theme-flexoki": "^0.2.2",
    "starlight-theme-galaxy": "^0.8.0",
    "starlight-theme-gruvbox": "^2.0.0",
    "starlight-theme-md3": "^0.2.1",
    "starlight-theme-mdbook": "^0.1.5",
    "starlight-theme-next": "^0.4.0",
    "starlight-theme-nord": "^0.1.4",
    "starlight-theme-nova": "^0.12.2",
    "starlight-theme-rapide": "^0.5.2",
    "starlight-theme-rose-pine": "^0.2.0",
    "starlight-theme-terminal": "^1.3.0",
    "starlight-theme-vintage": "^0.1.0"
  },
  "devDependencies": {
    "@hideoo/eslint-config": "^5.2.1",
    "@hideoo/prettier-config": "^2.0.2",
    "@hideoo/tsconfig": "^2.0.4",
    "@types/node": "^22.18.8",
    "eslint": "^10.10.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vite-node": "^3.2.4"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "private": true,
  "sideEffects": false,
  "keywords": [
    "starlight",
    "themes",
    "preview",
    "documentation",
    "astro"
  ],
  "homepage": "https://github.com/HiDeoo/starlight-themes",
  "repository": {
    "type": "git",
    "url": "https://github.com/HiDeoo/starlight-themes.git"
  },
  "bugs": "https://github.com/HiDeoo/starlight-themes/issues"
}
